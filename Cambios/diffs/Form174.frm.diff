+'---INI---- xintec-nruz 04-11-2026 FCDVT-14: boton Cargar ----
+'Graba los grupos CARGADO de la carga (mCarga) con PKG_F8_GRABA_MASIVA_YZ.prc_graba:
+'libvta 'F8'/99 + zzz (+ termstat -1 si falta) para la Z y libvta 'Y' + zzz + termstaty -1
+'para cada Y. REEMPLAZA la Z y las Y que el terminal-dia ya tenga (como Form19). El package
+'hace commit por grupo: un grupo que falla queda en ERROR con el motivo y no deja nada a medias.
+Private Sub Command4_Click()
+    Dim cmd As ADODB.Command
+    Dim r As Integer, nCargados As Integer
+    Dim vOk As String, vErr As String
+
+    If mCarga <= 0 Then
+        MsgBox "Primero use Buscar para validar un archivo.", vbExclamation, Me.Caption
+        Exit Sub
+    End If
+    nCargados = 0
+    For r = 1 To Grid1.Rows - 1
+        If Grid1.TextMatrix(r, 6) = "CARGADO" Then nCargados = nCargados + 1
+    Next r
+    If nCargados = 0 Then
+        MsgBox "La carga N° " & mCarga & " no tiene grupos CARGADO para grabar.", vbExclamation, Me.Caption
+        Command4.Enabled = False
+        Exit Sub
+    End If
+    If MsgBox("Se grabarán " & nCargados & " cierre(s) de terminal (Z y sus Y) de la carga N° " & mCarga & "." & vbCrLf & vbCrLf & _
+              "Si un terminal ya tiene la Z o cierres Y ese día, se REEMPLAZAN por los del archivo." & vbCrLf & _
+              "Los grupos con error no se graban." & vbCrLf & vbCrLf & _
+              "¿Desea continuar?", vbQuestion + vbYesNo + vbDefaultButton2, Me.Caption) <> vbYes Then
+        Exit Sub
+    End If
+
+    lblLoad.Visible = True
+    Screen.MousePointer = vbHourglass
+    DoEvents
+
+    On Error GoTo oraerror
+    Set cmd = New ADODB.Command
+    Set cmd.ActiveConnection = Ado_Conn
+    With cmd
+        .CommandType = adCmdText
+        'xintec-nruz 04-11-2026 FCDVT-14: grabado en package propio (antes PKG_F8_CARGA_MASIVA_YZ.prc_graba)
+        '.CommandText = "BEGIN PKG_F8_CARGA_MASIVA_YZ.prc_graba(?, ?, ?, ?, ?); END;"
+        .CommandText = "BEGIN PKG_F8_GRABA_MASIVA_YZ.prc_graba(?, ?, ?, ?, ?); END;"
+        .Parameters.Append .CreateParameter(, adVarChar, adParamInput, 20, Flg_Pais$)
+        .Parameters.Append .CreateParameter(, adDouble, adParamInput, , mCarga)
+        .Parameters.Append .CreateParameter(, adVarChar, adParamInput, 50, LOGINUSER)
+        .Parameters.Append .CreateParameter(, adDouble, adParamOutput)
+        .Parameters.Append .CreateParameter(, adDouble, adParamOutput)
+        .Execute
+    End With
+    vOk = IIf(IsNull(cmd.Parameters(3).Value), "0", cmd.Parameters(3).Value)
+    vErr = IIf(IsNull(cmd.Parameters(4).Value), "0", cmd.Parameters(4).Value)
+    Set cmd.ActiveConnection = Nothing
+    Set cmd = Nothing
+
+    Call LlenaGrillaResumen(mCarga)
+    Command4.Enabled = False
+    Screen.MousePointer = vbDefault
+    lblLoad.Visible = False
+    MsgBox "Carga N° " & mCarga & vbCrLf & vbCrLf & _
+           "Grupos grabados: " & vOk & vbCrLf & _
+           "Grupos no grabados: " & vErr & vbCrLf & vbCrLf & _
+           "Clic en una fila para ver el detalle del log.", _
+           IIf(Val(vErr) > 0, vbExclamation, vbInformation), Me.Caption
+    Exit Sub
+oraerror:
+    Screen.MousePointer = vbDefault
+    lblLoad.Visible = False
+    If Not cmd Is Nothing Then Set cmd.ActiveConnection = Nothing
+    SystemMsg = "Problemas al grabar los cierres en la base (PKG_F8_GRABA_MASIVA_YZ.prc_graba, carga " & mCarga & ")"
+    frmLogOraError.Show 1
+    'Muestra como quedo cada grupo (los ya grabados quedan GRABADO)
+    Call LlenaGrillaResumen(mCarga)
+End Sub
+'---FIN---- xintec-nruz 04-11-2026 FCDVT-14: boton Cargar ----
+'---FIN----
+
+'---INI---- xintec-nruz 20-10-2026 FSCC-12901: PRUEBA cierre diario desde Salir (temporal) ----
+'Mientras no se programe nhal1, Salir ejecuta PKG_F8_CIERRE_DIARIO para FACO con la fecha
+'de prueba fija (vFechaPrueba = 02-11-2026 desde el 03-11, COMPENSA_DI prueba_test7; antes 14-10-2026 prueba_test6, 15-09-2026 prueba_test5, 20-08-2026 prueba_test4, 15-10-2026 FCDVT-56 y 17-09-2026 prueba_test3). Antes de produccion dejar Command3_Click solo con Unload Me.
+Private Sub Command3_Click()
+    Call EjecutaCierreDiario
+    Unload Me
+End Sub
+
+Private Sub EjecutaCierreDiario()
+    Dim cmd As ADODB.Command
+    Dim vEjecucion As String, vCerradas As String, vNoCerradas As String
+    Dim vFechaPrueba As String
+
+    'vFechaPrueba = "20260831"   'fecha de venta fija para la prueba en test (yyyymmdd)
+    'xintec-nruz 20-10-2026 FSCC-12901: fecha de prueba 10-09-2026 (antes 31-08-2026, prueba_test2)
+    'vFechaPrueba = "20260910"   'fecha de venta fija para la prueba en test (yyyymmdd)
+    'xintec-nruz 20-10-2026 FSCC-12901: fecha de prueba 17-09-2026 (antes 10-09-2026, prueba_test3 para la demostracion)
+    'vFechaPrueba = "20260917"   'fecha de venta fija para la prueba en test (yyyymmdd)
+    'xintec-nruz 22-10-2026 FCDVT-56: fecha de prueba 15-10-2026 (antes 17-09-2026; etapa sin venta, local 5 T2)
+    'vFechaPrueba = "20261015"   'fecha de venta fija para la prueba en test (yyyymmdd)
+    'xintec-nruz 22-10-2026 FSCC-12901: fecha de prueba 20-08-2026 (antes 15-10-2026; prueba_test4 COMPENSA_DI)
+    'vFechaPrueba = "20260820"   'fecha de venta fija para la prueba en test (yyyymmdd)
+    'xintec-nruz 26-10-2026 FSCC-12901: fecha de prueba 15-09-2026 (antes 20-08-2026; prueba_test5 COMPENSA_DI)
+    'vFechaPrueba = "20260915"   'fecha de venta fija para la prueba en test (yyyymmdd)
+    'xintec-nruz 28-10-2026 FSCC-12901: fecha de prueba 14-10-2026 (antes 15-09-2026; prueba_test6 COMPENSA_DI)
+    'vFechaPrueba = "20261014"   'fecha de venta fija para la prueba en test (yyyymmdd)
+    'xintec-nruz 03-11-2026 FSCC-12901: fecha de prueba 02-11-2026 (antes 14-10-2026; prueba_test7 COMPENSA_DI)
+    vFechaPrueba = "20261102"   'fecha de venta fija para la prueba en test (yyyymmdd)
+
+    On Error GoTo oraerror
+    Screen.MousePointer = vbHourglass
+    Set cmd = New ADODB.Command
+    Set cmd.ActiveConnection = Ado_Conn
+    With cmd
+        .CommandType = adCmdText
+        .CommandText = "BEGIN PKG_F8_CIERRE_DIARIO.prc_cierre_diario(?, to_date(?, 'yyyymmdd'), ?, ?, ?, ?); END;"
+        .Parameters.Append .CreateParameter(, adVarChar, adParamInput, 20, "FACO")
+        .Parameters.Append .CreateParameter(, adVarChar, adParamInput, 8, vFechaPrueba)
+        .Parameters.Append .CreateParameter(, adVarChar, adParamInput, 50, "PROC_CIERRE_DIARIO")
+        .Parameters.Append .CreateParameter(, adDouble, adParamOutput)
+        .Parameters.Append .CreateParameter(, adDouble, adParamOutput)
+        .Parameters.Append .CreateParameter(, adDouble, adParamOutput)
+        .Execute
+    End With
+    vEjecucion = IIf(IsNull(cmd.Parameters(3).Value), "", cmd.Parameters(3).Value)
+    vCerradas = IIf(IsNull(cmd.Parameters(4).Value), "0", cmd.Parameters(4).Value)
+    vNoCerradas = IIf(IsNull(cmd.Parameters(5).Value), "0", cmd.Parameters(5).Value)
+    Set cmd.ActiveConnection = Nothing
+    Set cmd = Nothing
+    Screen.MousePointer = vbDefault
+
+    MsgBox "Cierre diario FACO del " & Right(vFechaPrueba, 2) & "-" & Mid(vFechaPrueba, 5, 2) & "-" & Left(vFechaPrueba, 4) & " ejecutado." & vbCrLf & vbCrLf & _
+           "Ejecución: " & vEjecucion & vbCrLf & _
+           "Cajas cerradas: " & vCerradas & vbCrLf & _
+           "Cajas no cerradas: " & vNoCerradas & vbCrLf & vbCrLf & _
+           "Detalle en VTA_FACOLOG_CIERRE_DIARIO.", vbInformation, Me.Caption
+    Exit Sub
+oraerror:
+    Screen.MousePointer = vbDefault
+    If Not cmd Is Nothing Then Set cmd.ActiveConnection = Nothing
+    SystemMsg = "Problemas al ejecutar PKG_F8_CIERRE_DIARIO (cierre diario FACO)"
+    frmLogOraError.Show 1
+End Sub
+'---FIN----
