+Private Sub EjecutaCierreDiario()
+    Dim cmd As ADODB.Command
+    Dim vEjecucion As String, vCerradas As String, vNoCerradas As String
+    Dim vFechaPrueba As String
+
+    'vFechaPrueba = "20260831"   'fecha de venta fija para la prueba en test (yyyymmdd)
+    'xintec-nruz 20-10-2026 FSCC-12901: fecha de prueba 10-09-2026 (antes 31-08-2026, prueba_test2)
+    'vFechaPrueba = "20260910"   'fecha de venta fija para la prueba en test (yyyymmdd)
+    'xintec-nruz 20-10-2026 FSCC-12901: fecha de prueba 17-09-2026 (antes 10-09-2026, prueba_test3 para la demostracion)
+    'vFechaPrueba = "20260917"   'fecha de venta fija para la prueba en test (yyyymmdd)
+    'xintec-nruz 22-10-2026 FCDVT-56: fecha de prueba 15-10-2026 (antes 17-09-2026; etapa sin venta, local 5 T2)
+    'vFechaPrueba = "20261015"   'fecha de venta fija para la prueba en test (yyyymmdd)
+    'xintec-nruz 22-10-2026 FSCC-12901: fecha de prueba 20-08-2026 (antes 15-10-2026; prueba_test4 COMPENSA_DI)
+    vFechaPrueba = "20260820"   'fecha de venta fija para la prueba en test (yyyymmdd)
+
+    On Error GoTo oraerror
+    Screen.MousePointer = vbHourglass
+    Set cmd = New ADODB.Command
+    Set cmd.ActiveConnection = Ado_Conn
+    With cmd
+        .CommandType = adCmdText
+        .CommandText = "BEGIN PKG_F8_CIERRE_DIARIO.prc_cierre_diario(?, to_date(?, 'yyyymmdd'), ?, ?, ?, ?); END;"
+        .Parameters.Append .CreateParameter(, adVarChar, adParamInput, 20, "FACO")
+        .Parameters.Append .CreateParameter(, adVarChar, adParamInput, 8, vFechaPrueba)
+        .Parameters.Append .CreateParameter(, adVarChar, adParamInput, 50, "PROC_CIERRE_DIARIO")
+        .Parameters.Append .CreateParameter(, adDouble, adParamOutput)
+        .Parameters.Append .CreateParameter(, adDouble, adParamOutput)
+        .Parameters.Append .CreateParameter(, adDouble, adParamOutput)
+        .Execute
+    End With
+    vEjecucion = IIf(IsNull(cmd.Parameters(3).Value), "", cmd.Parameters(3).Value)
+    vCerradas = IIf(IsNull(cmd.Parameters(4).Value), "0", cmd.Parameters(4).Value)
+    vNoCerradas = IIf(IsNull(cmd.Parameters(5).Value), "0", cmd.Parameters(5).Value)
+    Set cmd.ActiveConnection = Nothing
+    Set cmd = Nothing
+    Screen.MousePointer = vbDefault
+
+    MsgBox "Cierre diario FACO del " & Right(vFechaPrueba, 2) & "-" & Mid(vFechaPrueba, 5, 2) & "-" & Left(vFechaPrueba, 4) & " ejecutado." & vbCrLf & vbCrLf & _
+           "Ejecución: " & vEjecucion & vbCrLf & _
+           "Cajas cerradas: " & vCerradas & vbCrLf & _
+           "Cajas no cerradas: " & vNoCerradas & vbCrLf & vbCrLf & _
+           "Detalle en VTA_FACOLOG_CIERRE_DIARIO.", vbInformation, Me.Caption
+    Exit Sub
+oraerror:
+    Screen.MousePointer = vbDefault
+    If Not cmd Is Nothing Then Set cmd.ActiveConnection = Nothing
+    SystemMsg = "Problemas al ejecutar PKG_F8_CIERRE_DIARIO (cierre diario FACO)"
+    frmLogOraError.Show 1
+End Sub
