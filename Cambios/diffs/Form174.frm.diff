+        .Parameters.Append .CreateParameter(, adVarChar, adParamInput, 20, "FACO")
+        .Parameters.Append .CreateParameter(, adVarChar, adParamInput, 8, vFechaPrueba)
+        .Parameters.Append .CreateParameter(, adVarChar, adParamInput, 50, "PROC_CIERRE_DIARIO")
+        .Parameters.Append .CreateParameter(, adDouble, adParamOutput)
+        .Parameters.Append .CreateParameter(, adDouble, adParamOutput)
+        .Parameters.Append .CreateParameter(, adDouble, adParamOutput)
+        .Execute
+    End With
+    vEjecucion = IIf(IsNull(cmd.Parameters(3).Value), "", cmd.Parameters(3).Value)
+    vCerradas = IIf(IsNull(cmd.Parameters(4).Value), "0", cmd.Parameters(4).Value)
+    vNoCerradas = IIf(IsNull(cmd.Parameters(5).Value), "0", cmd.Parameters(5).Value)
+    Set cmd.ActiveConnection = Nothing
