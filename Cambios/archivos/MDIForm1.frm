Function GetRuta(varCod As Integer) As String
Set Consulta = CreateObject("ADODB.Recordset")
With Consulta
    .ActiveConnection = Ado_Conn
    .CursorLocation = adUseClient
    .CursorType = adOpenForwardOnly
    .LockType = adLockReadOnly
End With

sq = " select m.vta_xglosa from vta_sfclparam m "
sq = sq & " where m.vta_ccodtipo = 6200 and m.vta_ccodigo = " & varCod

Call Consulta.Open(sq)

If Consulta.RecordCount = 0 Then
    MsgBox "No existe ruta del archivo, comunique a su proveedor de servicio."
Else
    GetRuta = Consulta.Fields(0).Value
End If

Set Consulta.ActiveConnection = Nothing
Exit Function
salir:
    Set Consulta.ActiveConnection = Nothing
    SystemMsg = "Problemas de comunicación con servidor   "
    frmLogOraError.Show 1
    Exit Function
End Function

