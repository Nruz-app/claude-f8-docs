'MM: 166355 - Añadir nueva opción F8 - Ingreso de Z en TB
Function GetOpcionMenuIngresoZTB(CodigoPerfil As String)
Set Consulta = CreateObject("ADODB.Recordset")
With Consulta
    .ActiveConnection = Ado_Conn
    .CursorLocation = adUseClient
    .CursorType = adOpenForwardOnly
    .LockType = adLockReadOnly
End With

sq = " select p.mnu_codigo , p.rel_estado  " & _
         " from VTA_" & Flg_Pais$ & "relpermen p " & ",VTA_" & Flg_Pais$ & "menu m " & _
         " where p.mnu_codigo = m.mnu_codigo   " & _
         " and m.mnu_tipomenu = 'opcion'  " & _
         " and p.per_codigo = " & CodigoPerfil & " " & _
         " and p.rel_estado = -1  " & _
         " and m.mnu_descripcion = 'Ingreso de Z en TB'  "
         
Call Consulta.Open(sq)

If Consulta.RecordCount = 0 Then
    Is_user_z_tb = False
Else
    Is_user_z_tb = True
End If

Set Consulta.ActiveConnection = Nothing
Exit Function
salir:
    Set Consulta.ActiveConnection = Nothing
    SystemMsg = "Problemas de comunicación con servidor   "
    frmLogOraError.Show 1
    Exit Function
End Function
